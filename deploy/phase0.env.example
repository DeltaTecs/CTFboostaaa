# Copy to .env and export values into the invoking shell; never commit keys.
# The probes do not load .env automatically. Provider requests require --live.
HEXSTRIKE_URL=http://127.0.0.1:8888
HEXSTRIKE_SOURCE=/home/u/workspace/hexstrike/hexstrike-ai
HEXSTRIKE_PYTHON=/home/u/workspace/hexstrike/hexstrike-ai/hexstrike-env/bin/python

# Choose models available to your account. No fixed model IDs are assumed.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_OPTIONS_JSON={}

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Only set model-supported thinking/reasoning options after selecting a model.
DEEPSEEK_OPTIONS_JSON={}

ALIBABA_API_KEY=
ALIBABA_MODEL=
ALIBABA_REGION=
ALIBABA_WORKSPACE=
# Required. Use an endpoint and API key for the same region/workspace/billing plan.
# Singapore legacy example: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Workspace example: https://WORKSPACE.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
ALIBABA_BASE_URL=
# Thinking/tool parameters are model-dependent; no implicit enable_thinking value.
ALIBABA_OPTIONS_JSON={}
